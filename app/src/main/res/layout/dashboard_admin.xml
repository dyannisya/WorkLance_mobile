<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    android:background="#FFFFFF"
    android:fontFamily="inter">

    <!-- ===== TOP BAR (di luar ScrollView, sticky di atas) ===== -->
    <LinearLayout
        android:id="@+id/linearLayoutTop"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="46dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:src="@drawable/ic_logodashboard" />

        <ImageView
            android:id="@+id/imgadmin"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:src="@drawable/ic_admin" />

        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_koper" />
    </LinearLayout>

    <!-- ===== BUTTOM NAV (di luar ScrollView, sticky di atas) ===== -->
    <LinearLayout
        android:id="@+id/linearLayoutNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="845dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="52dp"
        android:paddingEnd="52dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btncari"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginEnd="38dp"
            android:src="@drawable/ic_klpengguna"
            app:tint="#161E54"/>

        <ImageView
            android:id="@+id/btnbag"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="38dp"
            android:src="@drawable/ic_bag" />

        <ImageView
            android:id="@+id/btnhome"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="38dp"
            android:src="@drawable/ic_dashboardadmin" />

        <ImageView
            android:id="@+id/btnriwayat"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="38dp"
            android:src="@drawable/ic_booking" />

        <ImageView
            android:id="@+id/btnprofil"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_pengajuan" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/linearLayoutTop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/editText1"
                android:layout_width="361dp"
                android:layout_height="62dp"
                android:layout_marginStart="25dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_search"
                android:padding="12dp"
                android:inputType="text"
                android:hint="Cari Booking..."
                android:textColorHint="#B3B3B3"
                tools:ignore="MissingConstraints"
                android:drawableEnd="@drawable/icon_search"
                android:drawablePadding="5dp"
                app:layout_constraintTop_toBottomOf="@+id/linearLayoutTop"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:id="@+id/linearLayout1"
                android:layout_width="364dp"
                android:layout_height="78dp"
                android:orientation="horizontal"
                android:layout_marginStart="24dp"
                android:layout_marginTop="29dp"
                app:layout_constraintTop_toBottomOf="@+id/editText1"
                app:layout_constraintStart_toStartOf="parent">

                <!-- Card 1: Menunggu -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardElevation="3dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/card1"
                        android:layout_width="173dp"
                        android:layout_height="78dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="20dp"
                            android:src="@drawable/ic_profilbtn"
                            android:scaleType="centerCrop" />
                    </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:layout_marginStart="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:layout_marginStart="55dp"
                            android:text="10"
                            android:textColor="#161E54"
                            android:textSize="32sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="55dp"
                            android:layout_marginTop="-2dp"
                            android:text="Total Pengguna"
                            android:textColor="#000000"
                            android:textSize="10sp"
                            android:textStyle="bold"/>
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Card 2 -->
                    <LinearLayout
                        android:id="@+id/card2"
                        android:layout_width="173dp"
                        android:layout_height="78dp"
                        android:layout_marginStart="190dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        tools:ignore="DuplicateIds">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/card2"
                            android:layout_width="173dp"
                            android:layout_height="78dp"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="20dp"
                                android:layout_marginTop="20dp"
                                android:src="@drawable/ic_bag"
                                android:scaleType="centerCrop" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:layout_marginStart="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:layout_marginStart="55dp"
                                android:text="10"
                                android:textColor="#161E54"
                                android:textSize="32sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="55dp"
                                android:layout_marginTop="-2dp"
                                android:text="Total Freelancer"
                                android:textColor="#000000"
                                android:textSize="10sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </RelativeLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout2"
                android:layout_width="364dp"
                android:layout_height="78dp"
                android:orientation="horizontal"
                android:layout_marginStart="24dp"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout1"
                app:layout_constraintStart_toStartOf="parent">

                <!-- Card 3 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardElevation="3dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/card3"
                            android:layout_width="173dp"
                            android:layout_height="78dp"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="20dp"
                                android:layout_marginTop="20dp"
                                android:src="@drawable/ic_ttlbooking"
                                android:scaleType="centerCrop" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:layout_marginStart="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:layout_marginStart="55dp"
                                android:text="9"
                                android:textColor="#161E54"
                                android:textSize="32sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="55dp"
                                android:layout_marginTop="-2dp"
                                android:text="Total Booking"
                                android:textColor="#000000"
                                android:textSize="10sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Card 4 -->
                    <LinearLayout
                        android:id="@+id/card4"
                        android:layout_width="173dp"
                        android:layout_height="78dp"
                        android:layout_marginStart="190dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        tools:ignore="DuplicateIds">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/card4"
                            android:layout_width="173dp"
                            android:layout_height="78dp"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="20dp"
                                android:layout_marginTop="20dp"
                                android:src="@drawable/ic_check"
                                android:scaleType="centerCrop" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:layout_marginStart="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:layout_marginStart="55dp"
                                android:text="3"
                                android:textColor="#161E54"
                                android:textSize="32sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="55dp"
                                android:layout_marginTop="-2dp"
                                android:text="Total Selesai"
                                android:textColor="#000000"
                                android:textSize="10sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </RelativeLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <TextView
                android:id="@+id/textView7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Booking Terbaru"
                android:layout_marginTop="20dp"
                android:layout_marginStart="24dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#161E54"
                android:drawableEnd="@drawable/btn_lihat"
                android:drawablePadding="160dp"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout2"
                app:layout_constraintStart_toStartOf="parent"/>


            <LinearLayout
                android:id="@+id/HeaderTable"
                android:layout_width="364dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="24dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView7">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="121dp"
                        android:layout_height="31dp"
                        android:gravity="center"
                        android:text="Nama Client"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="121dp"
                        android:layout_height="31dp"
                        android:gravity="center"
                        android:text="Jasa"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="121dp"
                        android:layout_height="31dp"
                        android:gravity="center"
                        android:text="Status"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0" />

                <TextView
                    android:id="@+id/txtEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Belum ada jasa"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:visibility="gone"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
            </LinearLayout>

            <TextView
                android:id="@+id/textView9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pengajuan Terbaru"
                android:layout_marginTop="20dp"
                android:layout_marginStart="24dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#161E54"
                android:drawableEnd="@drawable/btn_lihat"
                android:drawablePadding="160dp"
                app:layout_constraintTop_toBottomOf="@+id/HeaderTable"
                app:layout_constraintStart_toStartOf="parent"/>

            <LinearLayout
                android:layout_width="364dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="5dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/bg_card"
                app:layout_constraintTop_toBottomOf="@+id/textView8"
                app:layout_constraintStart_toStartOf="parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginTop="10dp"
                            android:src="@drawable/bg_circle_gray"
                            android:scaleType="centerCrop" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="6dp"
                        android:layout_marginStart="75dp">

                    <TextView
                        android:id="@+id/namafreelancer1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="5dp"
                        android:text="Andi Wijaya"
                        android:textColor="#1A1A2E"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                        <ImageView
                            android:id="@+id/btnstatus1"
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:src="@drawable/status_diterima" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btndetail1"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginStart="270dp"
                        android:src="@drawable/status_detail" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginTop="10dp"
                            android:src="@drawable/bg_circle_gray"
                            android:scaleType="centerCrop" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="6dp"
                        android:layout_marginStart="75dp">

                        <TextView
                            android:id="@+id/namafreelancer2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="5dp"
                            android:text="Linda Putri"
                            android:textColor="#1A1A2E"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                        <ImageView
                            android:id="@+id/btnstatus2"
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:src="@drawable/status_diterima" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btndetail2"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginStart="270dp"
                        android:src="@drawable/status_detail" />
                </RelativeLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/textView10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kategori Terpopuler"
                android:layout_marginTop="20dp"
                android:layout_marginStart="24dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#161E54"
                app:layout_constraintTop_toBottomOf="@+id/HeaderTable"
                app:layout_constraintStart_toStartOf="parent"/>

            <LinearLayout
                android:layout_width="364dp"
                android:layout_height="150dp"
                android:orientation="vertical"
                android:layout_marginTop="5dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="#161E54"
                app:layout_constraintTop_toBottomOf="@+id/textView10"
                app:layout_constraintStart_toStartOf="parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="35dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/namakategori1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="15dp"
                            android:layout_marginStart="20dp"
                            android:text="Desain Kreatif"
                            android:textColor="#ffffff"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/jumlah1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="15dp"
                            android:layout_marginStart="170dp"
                            android:text="2 freelancer"
                            android:textColor="#ffffff"
                            android:textSize="10sp"/>
                    </LinearLayout>
                </RelativeLayout>
                <ImageView
                    android:layout_width="320dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="20dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/badge_diproses" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="35dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/namakategori2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="15dp"
                            android:layout_marginStart="20dp"
                            android:text="Foto/Vidiografis"
                            android:textColor="#ffffff"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/jumlah2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="15dp"
                            android:layout_marginStart="157dp"
                            android:text="2 freelancer"
                            android:textColor="#ffffff"
                            android:textSize="10sp"/>
                    </LinearLayout>
                </RelativeLayout>
                <ImageView
                    android:layout_width="320dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="20dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/badge_diproses" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="35dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/namakategori3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="15dp"
                            android:layout_marginStart="20dp"
                            android:text="Teknisi"
                            android:textColor="#ffffff"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/jumlah3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="15dp"
                            android:layout_marginStart="212dp"
                            android:text="2 freelancer"
                            android:textColor="#ffffff"
                            android:textSize="10sp"/>
                    </LinearLayout>
                </RelativeLayout>
                <ImageView
                    android:layout_width="320dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="20dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/badge_diproses" />
            </LinearLayout>


        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>