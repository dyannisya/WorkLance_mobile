<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="4dp"
        android:paddingVertical="15dp"
        android:gravity="top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvRiwayat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="45dp"
            android:text="Cari"
            android:textColor="#161E54"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="0dp"
            android:orientation="horizontal"
            android:padding="16dp"
            android:elevation="3dp">

            <!-- ===== PENCARIAN ===== -->
            <EditText
                android:id="@+id/editTextText3"
                android:layout_width="300dp"
                android:layout_height="52dp"
                android:layout_marginStart="0dp"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_search"
                android:padding="12dp"
                android:inputType="text"
                android:hint="Cari jasa yang kamu butuhkan.."
                android:textColorHint="#B3B3B3"
                android:drawableEnd="@drawable/icon_search"
                android:drawablePadding="5dp" />

            <ImageView
                android:id="@+id/filter"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/filtersearch"
                android:scaleType="centerCrop"
                android:padding="10dp"
                android:layout_marginLeft="20dp"
                android:background="@drawable/bg_card"
                android:layout_centerVertical="true" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rekomendasi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <TextView
            android:id="@+id/rekomendasitext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="0dp"
            android:text="Rekomendasi"
            android:textColor="#161E54"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/kategorirekom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/rekomendasitext">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="15dp"
                android:text="Desain Kreatif"
                android:textColor="#161E54"
                android:textSize="15sp"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_transparan_biru"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:text="Teknisi"
                android:textColor="#161E54"
                android:textSize="15sp"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_transparan_biru"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:text="IT Digital"
                android:textColor="#161E54"
                android:textSize="15sp"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_transparan_biru"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/kategorirekom2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/kategorirekom">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="15dp"
                android:text="Foto Videografi"
                android:textColor="#161E54"
                android:textSize="15sp"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_transparan_biru"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:text="IT Digital"
                android:textColor="#161E54"
                android:textSize="15sp"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_transparan_biru"/>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/riwayat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@+id/rekomendasi">

        <TextView
            android:id="@+id/riwayat1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="0dp"
            android:text="Riwayat Pencarian"
            android:textColor="#161E54"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/riwayat2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/rekomendasitext">

            <ImageView
                android:id="@+id/riwayat3"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="15dp"
                android:padding="4dp"
                android:src="@drawable/history" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="15dp"
                android:text="Desain Kreatif"
                android:textColor="#161E54"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/riwayat4"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="210dp"
                android:layout_marginTop="15dp"
                android:padding="6dp"
                android:src="@drawable/close" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/riwayat5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/kategorirekom">



        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvEmptyHasil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Layanan tidak ditemukan"
        android:gravity="center"
        android:padding="40dp"
        android:textSize="16sp"
        android:textColor="#8A8A8A"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewHasil"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="52dp"
        android:paddingEnd="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/btncari"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginEnd="38dp"
            android:src="@drawable/icon_search" />

        <ImageView
            android:id="@+id/btnbag"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="38dp"
            android:src="@drawable/ic_bag" />

        <ImageView
            android:id="@+id/btnhome"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="38dp"
            android:src="@drawable/ic_home" />

        <ImageView
            android:id="@+id/btnriwayat"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="38dp"
            android:src="@drawable/ic_history"/>

        <ImageView
            android:id="@+id/btnprofil"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_profilbtn" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>