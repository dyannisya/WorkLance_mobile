<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ===== TOP BAR (di luar ScrollView, sticky di atas) ===== -->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="46dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="#ffffff"
            android:drawableStart="@drawable/icon_back"
            android:drawablePadding="5dp"
            android:gravity="center_vertical"
            android:paddingEnd="24dp"
            android:text="Kategori Jasa Freelancer"
            android:textColor="#161E54"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">

        <LinearLayout
            android:id="@+id/linear1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <!-- ===== profil singkat ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/bg_circle_gray"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rizky Pratama"
                        android:textColor="#161E54"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Konfigurasi Jasa yang Anda Tawarkan"
                        android:textColor="#161E54"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="364dp"
                android:layout_height="720dp"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/bg_card"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linear1">

                <!-- ===== KATEGORI ===== -->
                <TextView
                    android:layout_width="232dp"
                    android:layout_height="19dp"
                    android:text="Kategori Keahlian Utama *"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="37dp"
                    android:textColor="#161E54"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="MissingConstraints" />

                <Spinner
                    android:id="@+id/spinnerKategori"
                    android:layout_width="327dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="MissingConstraints"/>

                <!-- ===== HARGA ===== -->
                <TextView
                    android:layout_width="232dp"
                    android:layout_height="19dp"
                    android:text="Harga Dasar Minimum Order *"
                    android:drawableStart="@drawable/ic_harga"
                    android:drawablePadding="5dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="16dp"
                    android:textColor="#161E54"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="MissingConstraints" />

                <LinearLayout
                    android:layout_width="327dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_card"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Rp"
                        android:textColor="#939393" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#E0E0E0" />

                    <EditText
                        android:id="@+id/etHarga"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:inputType="number"
                        android:paddingStart="12dp"
                        android:text="500.000"
                        android:textColor="#000000"
                        android:textSize="16sp"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#E0E0E0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="#F5F5F5"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="/"
                        android:textColor="#546E7A" />

                    <Spinner
                        android:id="@+id/spinnerTipeHarga"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@null" />
                </LinearLayout>

                <!-- ===== PILIH JASA ===== -->
                <TextView
                    android:layout_width="257dp"
                    android:layout_height="19dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="15dp"
                    android:drawableStart="@drawable/ic_pilih"
                    android:drawablePadding="5dp"
                    android:text="Pilih Jasa Yang Anda Sediakan *"
                    android:textColor="#161E54"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="MissingConstraints" />

                <Spinner
                    android:id="@+id/spinnerJasa"
                    android:layout_width="327dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="16dp"
                    android:entries="@array/kategori_jasa"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="MissingConstraints"/>

                <!-- ===== NAMA JASA ===== -->
                <TextView
                    android:layout_width="257dp"
                    android:layout_height="19dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="15dp"
                    android:drawableStart="@drawable/ic_edit_orange"
                    android:drawablePadding="5dp"
                    android:text="Nama Jasa *"
                    android:textColor="#161E54"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="MissingConstraints" />

                <EditText
                    android:id="@+id/etNamaJasa"
                    android:layout_width="327dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/edittext_border"
                    android:paddingStart="16dp"
                    android:text="Desain Konten Instagram"
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <!-- ===== DESKRIPSI ===== -->
                <TextView
                    android:layout_width="257dp"
                    android:layout_height="19dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="15dp"
                    android:drawableStart="@drawable/ic_deskripsi"
                    android:drawablePadding="5dp"
                    android:text="Deskripsi Jasa *"
                    android:textColor="#161E54"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="MissingConstraints" />

                <EditText
                    android:id="@+id/etDeskripsi"
                    android:layout_width="327dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/edittext_border"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:padding="16dp"
                    android:text="Jasa desain konten Instagram untuk membuat feed Anda lebih menarik dan profesional. Desain dibuat original, disesuaikan dengan identitas brand dan target audiens. Cocok untuk kebutuhan promosi, edukasi, maupun branding. Tersedia revisi dan file siap upload."
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <!-- ===== GAMBAR HEADER ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tambahkan Gambar Header"
                        android:textColor="#161E54"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_gambar"
                        android:drawablePadding="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" (PNG/JPG)"
                        android:textColor="#757575"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-Max. 2MB"
                        android:textColor="#E53935"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="327dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/edittext_border"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <Button
                        android:id="@+id/btnPilihFile1"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="120dp"
                        android:layout_height="48dp"
                        android:backgroundTint="#B3E5FC"
                        android:text="Pilih File"
                        android:textAllCaps="false"
                        android:textColor="#1A237E"
                        app:cornerRadius="4dp"
                        app:strokeColor="#1A237E"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_chip_dark"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DesainKonten.png"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="8dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="#FF9800" />
                </LinearLayout>
                <!-- ===== GAMBAR PENDUKUNG ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tambahkan Gambar Pendukung"
                        android:textColor="#161E54"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_gambar"
                        android:drawablePadding="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" (PNG/JPG)"
                        android:textColor="#757575"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-Max. 2MB"
                        android:textColor="#E53935"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="327dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/edittext_border"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <Button
                        android:id="@+id/btnPilihFile2"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="120dp"
                        android:layout_height="48dp"
                        android:backgroundTint="#B3E5FC"
                        android:text="Pilih File"
                        android:textAllCaps="false"
                        android:textColor="#1A237E"
                        app:cornerRadius="4dp"
                        app:strokeColor="#1A237E"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_chip_dark"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DesainKonten.png"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="8dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="#FF9800" />
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimpanEdit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:text="Simpan Perubahan"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:backgroundTint="#161E54"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </ScrollView>




</androidx.constraintlayout.widget.ConstraintLayout>