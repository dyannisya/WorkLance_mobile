<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentTop="true"
        android:elevation="4dp"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical"
        tools:ignore="MissingConstraints">

        <ImageButton
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_circle_gray"

            android:src="@drawable/close"
            app:tint="#161E54"
            tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginTop="40dp"
            android:text="Filter"
            android:textColor="#161E54"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="330dp"
            android:layout_marginTop="38dp"
            android:text="Reset"
            android:textColor="#D0D0D0"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <TextView
            android:id="@+id/filter1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="0dp"
            android:text="Lokasi"
            android:textColor="#161E54"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/filterlokasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/filter1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="15dp"
                android:text="Sidoarjo"
                android:textColor="#161E54"
                android:textSize="15sp"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_transparan_biru"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:text="Surabaya"
                android:textColor="#161E54"
                android:textSize="15sp"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_transparan_biru"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:text="Malang"
                android:textColor="#161E54"
                android:textSize="15sp"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_transparan_biru"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/filterlokasi2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/kategorirekom">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="15dp"
                android:text="Pasuruan"
                android:textColor="#161E54"
                android:textSize="15sp"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_transparan_biru"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:text="Jember"
                android:textColor="#161E54"
                android:textSize="15sp"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_transparan_biru"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/semualokasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/filterlokasi2">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="13dp"
                android:text="Semua Lokasi"
                android:textColor="#D0D0D0"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/next"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rangeHarga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/filter">

        <TextView
            android:id="@+id/rangeHarga2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="0dp"
            android:text="Rentang Harga"
            android:textColor="#161E54"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/rangeHarga3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/rangeHarga2">

            <EditText
                android:id="@+id/inputMin"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:ems="10"
                android:inputType="text"
                android:minHeight="48dp"
                android:padding="12dp"
                android:layout_marginStart="20dp"
                android:hint="MIN"
                android:textColorHint="#B7B3B3B3"
                android:textAlignment="center"
                tools:ignore="TextSizeCheck" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/strip"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

            <EditText
                android:id="@+id/inputMax"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:ems="10"
                android:inputType="text"
                android:minHeight="48dp"
                android:padding="12dp"
                android:layout_marginStart="10dp"
                android:hint="MAX"
                android:textColorHint="#B7B3B3B3"
                android:textAlignment="center"
                tools:ignore="TextSizeCheck" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/filterrangeharga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/filter1">

            <TextView
                android:id="@+id/range1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="15dp"
                android:text="0-150RB"
                android:textColor="#161E54"
                android:textSize="16sp"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_transparan_biru"/>

            <TextView
                android:id="@+id/range2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:text="150-450RB"
                android:textColor="#161E54"
                android:textSize="16sp"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_transparan_biru"/>

            <TextView
                android:id="@+id/range3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:text="450-850RB"
                android:textColor="#161E54"
                android:textSize="16sp"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_transparan_biru"/>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLanjutkan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="40dp"
            android:layout_marginHorizontal="14dp"
            android:layout_marginBottom="14dp"

            android:text="Terapkan Filter"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"

            android:elevation="4dp"
            android:backgroundTint="#161E54"

            app:cornerRadius="12dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>