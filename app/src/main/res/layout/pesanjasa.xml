<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- TOOLBAR -->
    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentTop="true"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical">

        <ImageButton
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="40dp"
            android:src="@drawable/icon_back"

            android:tint="#161E54"
            android:background="@android:color/transparent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginTop="40dp"
            android:text="Pesan Jasa"
            android:textColor="#161E54"
            android:textSize="22sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- SCROLL CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btnLanjutkan"
        android:layout_below="@id/toolbar"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- NOTIF WAKTU RESPON -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_transparan"
                android:padding="10dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="#F16D34"
                    android:contentDescription="Info" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Waktu Respon Cepat"
                        android:textColor="#E65100"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Freelancer ini biasanya merespon dalam 1 jam"
                        android:textColor="#BF360C"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- HARGA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Garis kiri -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="#161E54"
                    android:layout_marginEnd="10dp"/>

                <!-- Text -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Harga Mulai dari"
                        android:textColor="#161E54"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp500.000 / Project"
                        android:textColor="#F16D34"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- DESKRIPSI PEKERJAAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <!-- Garis kiri -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="#161E54"
                    android:layout_marginEnd="10dp"/>

                <!-- Isi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Deskripsi Pekerjaan "
                            android:textColor="#161E54"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*"
                            android:textColor="#F16D34"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                    </LinearLayout>

                    <EditText
                        android:id="@+id/etDeskripsi"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:background="#FFFFFF"
                        android:padding="12dp"
                        android:gravity="top|start"
                        android:hint="Ceritakan detail project Anda, dan apa yang sedang Anda butuhkan..."
                        android:textColorHint="#BBBBBB"
                        android:textColor="#1A1A2E"
                        android:textSize="13sp"
                        android:inputType="textMultiLine" />

                </LinearLayout>

            </LinearLayout>

            <!-- ALAMAT LENGKAP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <!-- Garis kiri -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="#161E54"
                    android:layout_marginEnd="10dp"/>

                <!-- Isi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alamat Lengkap "
                            android:textColor="#161E54"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*"
                            android:textColor="#F16D34"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                    </LinearLayout>

                    <EditText
                        android:id="@+id/etDeskripsi"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:background="#FFFFFF"
                        android:padding="12dp"
                        android:gravity="top|start"
                        android:hint="Ceritakan detail project Anda, dan apa yang sedang Anda butuhkan..."
                        android:textColorHint="#BBBBBB"
                        android:textColor="#1A1A2E"
                        android:textSize="13sp"
                        android:inputType="textMultiLine" />

                </LinearLayout>

            </LinearLayout>

            <!-- PILIH TANGGAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pilih Tanggal Pengerjaan "
                    android:textColor="#161E54"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="*"
                    android:textColor="#F16D34"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

            </LinearLayout>

            <!-- KALENDER CUSTOM -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Header Bulan -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="APRIL"
                        android:textColor="#1A1A2E"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="10dp" />

                    <!-- Header Hari -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7"
                        android:rowCount="1"
                        android:layout_marginBottom="6dp">

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1" android:text="MIN" android:textSize="11sp"
                            android:textStyle="bold" android:gravity="center" android:textColor="#888888"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1" android:text="SEN" android:textSize="11sp"
                            android:textStyle="bold" android:gravity="center" android:textColor="#888888"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1" android:text="SEL" android:textSize="11sp"
                            android:textStyle="bold" android:gravity="center" android:textColor="#888888"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1" android:text="RAB" android:textSize="11sp"
                            android:textStyle="bold" android:gravity="center" android:textColor="#888888"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1" android:text="KAM" android:textSize="11sp"
                            android:textStyle="bold" android:gravity="center" android:textColor="#888888"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1" android:text="JUM" android:textSize="11sp"
                            android:textStyle="bold" android:gravity="center" android:textColor="#888888"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1" android:text="SAB" android:textSize="11sp"
                            android:textStyle="bold" android:gravity="center" android:textColor="#888888"/>
                    </GridLayout>

                    <!-- Baris 1: 1-4 (mulai dari Selasa=kolom 2) -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7"
                        android:layout_marginBottom="2dp">

                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="" android:gravity="center"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="" android:gravity="center"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="1" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day1"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="2" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day2"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="3" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day3"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="4" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day4"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="" android:gravity="center"/>
                    </GridLayout>

                    <!-- Baris 2: 5-11 -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7"
                        android:layout_marginBottom="2dp">

                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="5" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day5"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="6" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day6"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="7" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day7"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="8" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day8"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="9" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day9"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="10" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day10"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="11" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day11"/>
                    </GridLayout>

                    <!-- Baris 3: 12-18 -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7"
                        android:layout_marginBottom="2dp">

                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="12" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day12"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="13" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day13"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="14" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day14"/>
                        <!-- Tanggal 15 = Selected (pink) -->
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="15" android:textSize="13sp"
                            android:gravity="center" android:textColor="#161E54"
                            android:background="#FFFFFF" android:id="@+id/day15"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="16" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day16"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="17" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day17"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="18" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day18"/>
                    </GridLayout>

                    <!-- Baris 4: 19-25 -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7"
                        android:layout_marginBottom="2dp">

                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="19" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day19"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="20" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day20"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="21" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day21"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="22" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day22"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="23" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day23"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="24" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day24"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="25" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day25"/>
                    </GridLayout>

                    <!-- Baris 5: 26-30 -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7">

                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="26" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day26"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="27" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day27"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="28" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day28"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="29" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day29"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="30" android:textSize="13sp"
                            android:gravity="center" android:textColor="#1A1A2E" android:id="@+id/day30"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="" android:gravity="center"/>
                        <TextView android:layout_width="0dp" android:layout_height="36dp"
                            android:layout_columnWeight="1" android:text="" android:gravity="center"/>
                    </GridLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- TOMBOL LANJUTKAN -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLanjutkan"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="14dp"

        android:text="Lanjutkan Pemesanan"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"

        android:elevation="4dp"
        android:backgroundTint="#161E54"

        app:cornerRadius="12dp"/>

</RelativeLayout>