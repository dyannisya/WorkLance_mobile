<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fontFamily="inter">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/kelola"
        android:textColor="#161E54"
        android:textSize="24sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="59dp"
        tools:layout_editor_absoluteY="60dp"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/kategori_jasa_satuan"
        android:textColor="#161E54"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="59dp"
        tools:layout_editor_absoluteY="90dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn1"
        android:layout_width="111dp"
        android:layout_height="48dp"
        android:text="Kategori"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:backgroundTint="#B3B3B3"
        app:cornerRadius="10dp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="25dp"
        tools:layout_editor_absoluteY="190dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn2"
        android:layout_width="111dp"
        android:layout_height="48dp"
        android:text="Jasa"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:backgroundTint="#161E54"
        app:cornerRadius="10dp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="150dp"
        tools:layout_editor_absoluteY="190dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn1"
        android:layout_width="111dp"
        android:layout_height="48dp"
        android:text="Satuan"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:backgroundTint="#B3B3B3"
        app:cornerRadius="10dp"
        tools:ignore="MissingConstraints,TextSizeCheck"
        tools:layout_editor_absoluteX="275dp"
        tools:layout_editor_absoluteY="190dp" />

    <LinearLayout
        android:id="@+id/cardForm"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="25dp"
        tools:layout_editor_absoluteY="270dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tambah_jasa"
            android:textColor="#161E54"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="47dp"
            tools:layout_editor_absoluteY="256dp" />

        <TextView
            android:layout_width="232dp"
            android:layout_height="19dp"
            android:text="@string/pilih_kategori"
            android:textColor="#161E54"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="47dp"
            tools:layout_editor_absoluteY="293dp" />

        <Spinner
            android:id="@+id/spinner"
            android:entries="@array/kategori_jasa"
            android:layout_width="318dp"
            android:layout_height="48dp"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="47dp"
            tools:layout_editor_absoluteY="322dp" />

        <TextView
            android:layout_width="232dp"
            android:layout_height="19dp"
            android:text="@string/nama_jasa"
            android:textColor="#161E54"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="47dp"
            tools:layout_editor_absoluteY="380dp" />

        <EditText
            android:id="@+id/editTextText4"
            android:layout_width="318dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:background="@drawable/bg_search"
            android:padding="12dp"
            android:inputType="text"
            android:minHeight="48dp"
            android:text="Masukkan Nama Jasa di sini.."
            android:textColor="#B7B3B3B3"
            tools:ignore="TextSizeCheck" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button3"
            android:layout_width="327dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="Simpan"
            android:textSize="16sp"
            app:backgroundTint="#161E54"
            app:cornerRadius="10dp"
            android:layout_marginTop="12dp"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="47dp"
            tools:layout_editor_absoluteY="479dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="364dp"
        android:layout_height="309dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:padding="0dp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="25dp"
        tools:layout_editor_absoluteY="569dp">

        <TextView
            android:layout_width="121dp"
            android:layout_height="31dp"
            android:gravity="center"
            android:text="@string/namajasa"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="121dp"
            android:layout_height="31dp"
            android:gravity="center"
            android:text="@string/btnkategori"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="121dp"
            android:layout_height="31dp"
            android:gravity="center"
            android:text="@string/aksi"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <EditText
        android:id="@+id/editTextText3"
        android:layout_width="361dp"
        android:layout_height="62dp"
        android:background="@drawable/bg_search"
        android:padding="12dp"
        android:inputType="text"
        android:text="Cari Kategori, Jasa, dan Satuan..."
        android:textColor="#B3B3B3"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="25dp"
        tools:layout_editor_absoluteY="119dp" />


</androidx.constraintlayout.widget.ConstraintLayout>