<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    android:fontFamily="inter">

    <!-- ===== BUTTOM NAV (di luar ScrollView, sticky di atas) ===== -->
    <LinearLayout
        android:id="@+id/linearLayoutNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="52dp"
        android:paddingEnd="52dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/btncari"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginEnd="38dp"
            android:src="@drawable/ic_klpengguna"
            app:tint="#161E54"/>

        <ImageView
            android:id="@+id/btnbag"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="38dp"
            android:src="@drawable/ic_bag" />

        <ImageView
            android:id="@+id/btnhome"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="38dp"
            android:src="@drawable/ic_dashboardadmin" />

        <ImageView
            android:id="@+id/btnriwayat"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="38dp"
            android:src="@drawable/ic_booking" />

        <ImageView
            android:id="@+id/btnprofil"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_pengajuan" />
    </LinearLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="56dp"
        android:text="Kelola Booking"
        android:textColor="#161E54"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

    <EditText
        android:id="@+id/editText1"
        android:layout_width="361dp"
        android:layout_height="62dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="110dp"
        android:background="@drawable/bg_search"
        android:padding="12dp"
        android:inputType="text"
        android:hint="Cari Booking..."
        android:textColorHint="#B3B3B3"
        tools:ignore="MissingConstraints"
        android:drawableEnd="@drawable/icon_search"
        android:drawablePadding="5dp"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="364dp"
        android:layout_height="78dp"
        android:orientation="horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginTop="29dp"
        app:layout_constraintTop_toBottomOf="@+id/editText1"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Card 1: Menunggu -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardElevation="3dp">

            <LinearLayout
                android:id="@+id/card1"
                android:layout_width="173dp"
                android:layout_height="78dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCountMenunggu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="72dp"
                    android:text="2"
                    android:textColor="#161E54"
                    android:textSize="32sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="55dp"
                    android:layout_marginTop="-2dp"
                    android:text="Menunggu"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Card 2 -->
            <LinearLayout
                android:id="@+id/card2"
                android:layout_width="173dp"
                android:layout_height="78dp"
                android:layout_marginStart="190dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCountDiproses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="72dp"
                    android:layout_marginTop="5dp"
                    android:text="3"
                    android:textColor="#F16D34"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="58dp"
                    android:layout_marginTop="-2dp"
                    android:text="Diproses"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="364dp"
        android:layout_height="78dp"
        android:orientation="horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout1"
        app:layout_constraintStart_toStartOf="parent">

    <!-- Card 3 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardElevation="3dp">

        <LinearLayout
            android:id="@+id/card3"
            android:layout_width="173dp"
            android:layout_height="78dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCountSelesai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginStart="72dp"
                android:text="3"
                android:textColor="#44C33E"
                android:textSize="32sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="62dp"
                android:layout_marginTop="-2dp"
                android:text="Selesai"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Card 4 -->
        <LinearLayout
            android:id="@+id/card4"
            android:layout_width="173dp"
            android:layout_height="78dp"
            android:layout_marginStart="190dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCountDibatalkan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="72dp"
                android:layout_marginTop="5dp"
                android:text="1"
                android:textColor="#D90E0E"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="55dp"
                android:layout_marginTop="-2dp"
                android:text="Dibatalkan"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/horizontalScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="400dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn1"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:text="Semua"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                app:backgroundTint="#161E54"
                app:cornerRadius="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#939393"
                app:strokeWidth="1dp"
                tools:ignore="MissingConstraints,DuplicateSpeakableTextCheck" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn2"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:text="Menunggu"
                android:textColor="#939393"
                android:textSize="10sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="10dp"
                app:layout_constraintStart_toEndOf="@+id/btn1"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#939393"
                app:strokeWidth="1dp"
                tools:ignore="MissingConstraints,DuplicateSpeakableTextCheck" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn3"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:text="Diproses"
                android:textColor="#939393"
                android:textSize="10sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="10dp"
                app:layout_constraintStart_toEndOf="@+id/btn2"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#939393"
                app:strokeWidth="1dp"
                tools:ignore="MissingConstraints,DuplicateSpeakableTextCheck" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn4"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:text="Selesai"
                android:textColor="#939393"
                android:textSize="10sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="10dp"
                app:layout_constraintStart_toEndOf="@+id/btn3"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#939393"
                app:strokeWidth="1dp"
                tools:ignore="MissingConstraints,DuplicateSpeakableTextCheck" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn5"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:text="Dibatalkan"
                android:textColor="#939393"
                android:textSize="10sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="10dp"
                app:layout_constraintStart_toEndOf="@+id/btn4"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#939393"
                app:strokeWidth="1dp"
                tools:ignore="MissingConstraints,DuplicateSpeakableTextCheck" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/HeaderTable"
        android:layout_width="364dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="0dp"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/horizontalScrollView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="94dp"
            android:layout_height="31dp"
            android:gravity="center"
            android:text="Nama Client"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="90dp"
            android:layout_height="31dp"
            android:gravity="center"
            android:text="Jasa"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="90dp"
            android:layout_height="31dp"
            android:gravity="center"
            android:text="Status"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="90dp"
            android:layout_height="31dp"
            android:gravity="center"
            android:text="@string/aksi"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0" />

        <TextView
            android:id="@+id/txtEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada jasa"
            android:gravity="center"
            android:textSize="16sp"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>