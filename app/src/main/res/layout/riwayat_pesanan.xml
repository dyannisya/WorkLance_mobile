<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

        <RelativeLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:paddingHorizontal="15dp"
            android:gravity="top"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="45dp"
                android:text="Riwayat Pesanan"
                android:textColor="#161E54"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/icChat"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="25dp"
                android:layout_marginTop="45dp"
                android:src="@drawable/chat"
                app:tint="#161E54" />

            <HorizontalScrollView
                android:id="@+id/filterScroll"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="110dp"
                android:background="#FFFFFF"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="0dp">

                    <TextView
                        android:id="@+id/tabSemua"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_tab_active"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="Semua"
                        android:textColor="#FF6F00"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabMenunggu"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_tab_transparan"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="Menunggu"
                        android:textColor="#8A8A8A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabDiproses"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_tab_transparan"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="Diproses"
                        android:textColor="#8A8A8A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabSelesai"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_tab_transparan"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="Selesai"
                        android:textColor="#8A8A8A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabDibatalkan"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_tab_transparan"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="Dibatalkan"
                        android:textColor="#8A8A8A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </HorizontalScrollView>

        </RelativeLayout>

        <ScrollView
            android:id="@+id/scrollPesanan"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scrollbars="none"
            android:background="#F5F5F5"
            app:layout_constraintTop_toBottomOf="@+id/toolbar"
            app:layout_constraintBottom_toTopOf="@id/linearLayout2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/containerPesanan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="15dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tvEmptyRiwayat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Belum ada pesanan"
                    android:gravity="center"
                    android:padding="40dp"
                    android:textSize="16sp"
                    android:textColor="#8A8A8A"
                    android:visibility="gone"/>

                <!-- CARD 1: Andi Wijaya - Menunggu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_card">

                    <!-- Nama seller + badge -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Andi Wijaya"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#161E54"
                            android:layout_centerVertical="true"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Menunggu"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/badge_menunggu"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="16dp"
                        android:background="#F0F0F0"/>

                    <!-- Produk -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_gambar"
                            android:background="@drawable/rounded_image_bg"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Desain Logo"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#161E54"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp100.000"
                                android:textSize="13sp"
                                android:textColor="#333333"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="x1"
                            android:textSize="13sp"
                            android:textColor="#8A8A8A"
                            android:layout_gravity="center_vertical"/>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginBottom="8dp"/>

                    <!-- Total -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total 1 Produk: "
                            android:textSize="12sp"
                            android:textColor="#8A8A8A"/>

                        <TextView
                            android:id="@+id/tvTotal1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp100.000"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#161E54"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- CARD 2: Bagus Setiawan - Dibatalkan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_card">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bagus Setiawan"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#161E54"
                            android:layout_centerVertical="true"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dibatalkan"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/badge_dibatalkan"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"/>

                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="16dp"
                        android:background="#F0F0F0"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_gambar"
                            android:background="@drawable/rounded_image_bg"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Desain Poster"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#161E54"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp60.000"
                                android:textSize="13sp"
                                android:textColor="#333333"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="x2"
                            android:textSize="13sp"
                            android:textColor="#8A8A8A"
                            android:layout_gravity="center_vertical"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total 2 Produk: "
                            android:textSize="12sp"
                            android:textColor="#8A8A8A"/>

                        <TextView
                            android:id="@+id/tvTotal2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp120.000"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#161E54"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- CARD 3: Dewi Susanti - Diproses -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_card">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dewi Susanti"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#161E54"
                            android:layout_centerVertical="true"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Diproses"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/badge_diproses"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="16dp"
                        android:background="#F0F0F0"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_gambar"
                            android:background="@drawable/rounded_image_bg"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Editing Video"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#161E54"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp300.000"
                                android:textSize="13sp"
                                android:textColor="#333333"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="x1"
                            android:textSize="13sp"
                            android:textColor="#8A8A8A"
                            android:layout_gravity="center_vertical"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total 1 Produk: "
                            android:textSize="12sp"
                            android:textColor="#8A8A8A"/>

                        <TextView
                            android:id="@+id/tvTotal3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp300.000"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#161E54"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- CARD 4: Dewi Rahmawati - Selesai -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_card">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dewi Rahmawati"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#161E54"
                            android:layout_centerVertical="true"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Selesai"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/badge_selesai"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="16dp"
                        android:background="#F0F0F0"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_gambar"
                            android:background="@drawable/rounded_image_bg"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dokumentasi Acara"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#161E54"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp400.000"
                                android:textSize="13sp"
                                android:textColor="#333333"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="x1"
                            android:textSize="13sp"
                            android:textColor="#8A8A8A"
                            android:layout_gravity="center_vertical"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total 1 Produk: "
                            android:textSize="12sp"
                            android:textColor="#8A8A8A"/>

                        <TextView
                            android:id="@+id/tvTotal4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp400.000"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#161E54"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>


    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="52dp"
        android:paddingEnd="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/btncari"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginEnd="38dp"
            android:src="@drawable/icon_search"
            app:tint="#161E54"/>

        <ImageView
            android:id="@+id/btnbag"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="38dp"
            android:src="@drawable/ic_bag" />

        <ImageView
            android:id="@+id/btnhome"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="38dp"
            android:src="@drawable/ic_home" />

        <ImageView
            android:id="@+id/btnriwayat"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="38dp"
            android:src="@drawable/ic_history"
            app:tint="#F16D34"/>

        <ImageView
            android:id="@+id/btnprofil"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_profilbtn" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>